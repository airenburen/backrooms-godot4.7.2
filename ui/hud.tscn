[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://ui/hud.gd" id="1_script"]

[sub_resource type="Shader" id="Shader_vignette"]
code = "shader_type canvas_item;\nuniform float vignette_strength : hint_range(0.0, 1.0) = 0.0;\nuniform float pulse : hint_range(0.0, 1.0) = 0.0;\nvoid fragment() {\n    vec2 uv = UV;\n    float dist = distance(uv, vec2(0.5));\n    float edge = smoothstep(0.25, 0.75, dist);\n    vec3 col = vec3(0.45, 0.0, 0.0);\n    float a = edge * vignette_strength * 0.85 + pulse * vignette_strength * 0.5;\n    COLOR = vec4(col, clamp(a, 0.0, 0.75));\n}"

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1_script")

[node name="Vignette" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
